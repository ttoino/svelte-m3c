{
    "name": "svelte-m3c",
    "version": "0.0.5",
    "description": "Svelte 5 component library implementing Material Design 3",
    "type": "module",
    "license": "GPL-3.0-or-later",
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "style": "./dist/style/index.css",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "style": "./dist/style/index.css",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./paints/*": {
            "types": "./dist/paints/*.d.ts",
            "svelte": "./dist/paints/*.js",
            "default": "./dist/paints/*.js"
        },
        "./palette": {
            "types": "./dist/palette.d.ts",
            "svelte": "./dist/palette.js",
            "default": "./dist/palette.js"
        },
        "./style": {
            "types": "./dist/style.d.ts",
            "svelte": "./dist/style.js",
            "default": "./dist/style.js"
        },
        "./variants": {
            "types": "./dist/variants.d.ts",
            "svelte": "./dist/variants.js",
            "default": "./dist/variants.js"
        },
        "./*": {
            "style": "./dist/style/*.css"
        }
    },
    "peerDependencies": {
        "svelte": "^5.33.2"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "trap 'kill $!' EXIT; pnpm run dev --host --strict-port & vite build && pnpm run prepack",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "prepack": "svelte-kit sync && svelte-package && publint",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "gen": "pnpm run gen:cf-types",
        "gen:cf-types": "wrangler types src/worker-configuration.d.ts",
        "test": "vitest"
    },
    "dependencies": {
        "@fontsource-variable/roboto": "^5.2.8",
        "@fontsource-variable/roboto-mono": "^5.2.8",
        "@material/material-color-utilities": "^0.3.0",
        "bits-ui": "^2.11.4",
        "css-paint-polyfill": "^3.4.0",
        "material-symbols": "^0.36.2",
        "tailwind-merge": "^3.3.1",
        "tailwind-variants": "^3.1.1",
        "tailwindcss": "^4.1.14"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-cloudflare": "^7.2.8",
        "@sveltejs/kit": "^2.59.0",
        "@sveltejs/package": "^2.5.7",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/vite": "^4.2.4",
        "@types/node": "^22.0.0",
        "@vitest/browser-playwright": "^4.1.5",
        "dedent": "^1.7.0",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.9.0",
        "eslint-plugin-svelte": "^3.5.1",
        "globals": "^17.6.0",
        "new-javascript": "^0.4.7",
        "playwright": "^1.59.1",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^3.5.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "publint": "^0.3.18",
        "shiki": "^3.15.0",
        "svelte": "^5.55.5",
        "svelte-check": "^4.4.7",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.4",
        "vite": "^8.0.10",
        "vitest": "^4.1.7",
        "vitest-browser-svelte": "^2.0.1",
        "wrangler": "^4.94.0"
    },
    "keywords": [
        "svelte"
    ],
    "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}
